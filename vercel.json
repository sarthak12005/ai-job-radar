{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 3 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/cron",
      "dest": "/api/cron.py"
    },
    {
      "src": "/api/trigger",
      "dest": "/api/trigger.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}

